# Copy to .env and fill in. No real values belong in this file.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults for local use)
DATABASE_URL=postgres://dopamean:dopamean@localhost:5432/dopamean

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# HMAC key for pricing tokens, generate with `openssl rand -base64 32`
PRICING_TOKEN_SECRET=

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dopamean-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email: SMTP (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DOPAMEAN <no-reply@localhost>"

# Payments (Razorpay TEST mode). Leave empty until test keys are provided.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Business config
RESERVATION_TTL_MINUTES=15
ORDER_PAYMENT_DEADLINE_MINUTES=60

# Where contact-form messages are emailed (optional; they are always stored in the database)
CONTACT_INBOX=
# Public base URL for uploaded media in object storage (optional until uploads exist)
S3_PUBLIC_URL=

# Optional Sentry-compatible DSN
SENTRY_DSN=
